{
  "name": "sprout-mini-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "小芽 · 用对话制作小程序",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "electron .",
    "studio": "node cli/studio.mjs",
    "test:studio-native": "node --test tests/studio-native.check.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/package-desktop.mjs",
    "test:harness-ui": "node scripts/harness-ui-check.mjs",
    "test:harness-real": "node scripts/harness-real-check.mjs",
    "test:harness-business": "node scripts/harness-business-check.mjs"
  },
  "dependencies": {
    "@babel/preset-react": "^7.27.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@sinclair/typebox": "^0.34.41",
    "@tarojs/cli": "4.3.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "archiver": "^7.0.1",
    "babel-preset-taro": "4.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typebox": "^1.3.27",
    "undici": "^7.16.0",
    "webpack": "5.91.0",
    "playwright-core": "^1.63.0",
    "jsqr": "1.4.0",
    "pngjs": "3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "miniprogram-automator": "^0.12.1",
    "vite": "^4.5.14"
  },
  "build": {
    "appId": "studio.sprout.mini",
    "productName": "Sprout Studio",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "extraFiles": [
      {
        "from": "node_modules/@tarojs/components/lib/react/node_modules/.pnpm",
        "to": "resources/app/node_modules/@tarojs/components/lib/react/node_modules/.pnpm",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@tarojs/taro-h5/dist/node_modules/.pnpm",
        "to": "resources/app/node_modules/@tarojs/taro-h5/dist/node_modules/.pnpm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "cli/**/*",
      "server/**/*",
      "templates/**/*",
      "agent-skills/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
